{
  "apiVersion": 1,
  "id": "video-playback-mpv",
  "version": "26.8.16.1",
  "name": "视频播放器",
  "description": "使用独立 libmpv 进程、硬件解码和预读缓存播放相机原始视频。",
  "platforms": ["win32"],
  "architectures": ["x64"],
  "entrypoints": {
    "win32-x64": "advanced-video-decoder.exe"
  },
  "integrity": "component-integrity.json",
  "requiredFiles": [
    "libmpv-2.dll"
  ],
  "runtimeContributions": [
    {
      "type": "media.playbackBackend",
      "protocolVersion": 1,
      "backendId": "advanced-video",
      "transport": "native-process-v1",
      "priority": 80,
      "probe": {
        "containers": ["avi", "matroska", "mov", "mp4", "mpegts", "webm"],
        "codecs": {
          "video": ["av1", "h264", "hevc", "mpeg2video", "prores", "vp9"],
          "audio": ["aac", "ac3", "eac3", "flac", "mp3", "opus", "pcm"]
        },
        "extensions": [".avi", ".m4v", ".mkv", ".mov", ".mp4", ".mpeg", ".mpg", ".mts", ".m2ts", ".webm"]
      },
      "features": {
        "transforms": ["source", "contain", "cover", "16:9", "4:3", "1:1", "rotate", "flip-horizontal", "flip-vertical"],
        "hdr": { "modes": ["auto", "sdr", "hdr-passthrough", "tone-map"], "requiresHdrDisplay": true },
        "statistics": { "levels": ["basic", "detailed"], "maxUpdateHz": 10 },
        "subtitles": { "formats": ["vtt", "srt", "ass", "ssa"], "externalFiles": true },
        "hardwareDecoding": true,
        "capture": { "supported": true, "appliesTransforms": true }
      }
    }
  ]
}
