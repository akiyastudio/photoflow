{
  "name": "@photoflow/team-retouch",
  "version": "26.8.25.3",
  "private": true,
  "type": "module",
  "photoflowComponent": {
    "manifest": "component.template.json",
    "development": {
      "prepare": "build",
      "runtime": {
        "command": { "win32": ".venv/Scripts/python.exe", "default": ".venv/bin/python" },
        "entry": "team_retouch.py",
        "argsPrefix": ["-u"]
      },
      "files": {
        "team-retouch.exe": "team_retouch.py",
        "ui/index.html": "dist/ui/index.html",
        "ui/settings.html": "dist/ui/settings.html",
        "ui/team-retouch.svg": "renderer/team-retouch.svg",
        "_internal/models/rtmdet-ins_m_640x640.onnx": "models/rtmdet-ins_m_640x640.onnx",
        "_internal/models/face_detection_yunet_2023mar.onnx": "models/face_detection_yunet_2023mar.onnx",
        "_internal/models/adaface_ir18_webface4m.onnx": "models/adaface_ir18_webface4m.onnx",
        "_internal/models/osnet_x1_0_msmt17.onnx": "models/osnet_x1_0_msmt17.onnx"
      }
    },
    "tests": {
      "backup-restore": ["tests/test-team-retouch-host-backup-restore-e2e.cjs"],
      "package-layout": ["tests/test-team-retouch-package-layout.cjs"]
    }
  },
  "scripts": {
    "build": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc -p renderer/tsconfig.json --pretty false",
    "lint": "eslint renderer/src --report-unused-disable-directives --max-warnings 0",
    "test:node": "node scripts/run-node-tests.cjs",
    "test:python": ".venv\\Scripts\\python.exe tests/test-team-retouch.py && .venv\\Scripts\\python.exe tests/test-team-storage-isolation.py && .venv\\Scripts\\python.exe tests/test-team-retouch-progress-folder-policy.py",
    "test": "npm run setup:python && npm run typecheck && npm run lint && npm run build && npm run test:node && npm run test:python",
    "setup:python": "node scripts/setup-python.cjs",
    "package": "node scripts/package-component.cjs",
    "package:host": "node scripts/package-component.cjs",
    "package:advanced": "node scripts/build-advanced-package.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.14.0",
    "lucide-react": "^0.344.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.2.0"
  }
}
