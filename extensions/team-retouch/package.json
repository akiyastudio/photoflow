{
  "name": "@photoflow/team-retouch",
  "version": "26.8.25.3",
  "private": true,
  "type": "module",
  "photoflowComponent": { "manifest": "component.template.json" },
  "scripts": {
    "build": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc -p renderer/tsconfig.json --pretty false",
    "lint": "eslint renderer/src --report-unused-disable-directives --max-warnings 0",
    "test:node": "node scripts/run-node-tests.cjs",
    "test:python": ".venv\\Scripts\\python.exe tests/test-team-retouch.py && .venv\\Scripts\\python.exe tests/test-team-storage-isolation.py",
    "test": "npm run setup:python && npm run typecheck && npm run lint && npm run build && npm run test:node && npm run test:python",
    "setup:python": "node scripts/setup-python.cjs",
    "package": "node scripts/package-component.cjs",
    "package:host": "node scripts/package-component.cjs",
    "package:advanced": "node scripts/build-advanced-package.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.14.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.2.0"
  }
}
