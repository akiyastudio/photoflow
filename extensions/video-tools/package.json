{
  "name": "@photoflow/video-tools",
  "version": "26.8.29.1",
  "private": true,
  "scripts": { "build": "node scripts/verify-layout.cjs", "test": "node tests/test-service.cjs && node tests/test-runtime-boundary.cjs", "package": "node scripts/package-component.cjs", "package:host": "node scripts/package-component.cjs" },
  "photoflowComponent": {
    "manifest": "component.json",
    "development": {
      "prepare": "build",
      "runtime": { "command": "dev-python.cmd", "entry": "runtime/worker.py", "argsPrefix": ["-u"] },
      "files": {
        "service.cjs": "service.cjs",
        "runtime/video-tools-worker.exe": "runtime/worker.py",
        "runtime/worker.py": "runtime/worker.py",
        "runtime/ffmpeg_transcode.py": "runtime/ffmpeg_transcode.py",
        "runtime/cut_video.py": "runtime/cut_video.py",
        "runtime/ffmpeg_utils.py": "runtime/ffmpeg_utils.py",
        "runtime/video_preview.py": "runtime/video_preview.py",
        "ui/transcode.html": "ui/transcode.html",
        "ui/split.html": "ui/split.html",
        "ui/app.js": "ui/app.js",
        "ui/style.css": "ui/style.css",
        "ui/icon.svg": "ui/icon.svg",
        "README.md": "README.md",
        "LICENSES/README.md": "LICENSES/README.md"
      }
    },
    "tests": { "package-layout": ["tests/test-service.cjs", "tests/test-runtime-boundary.cjs"] }
  }
}
