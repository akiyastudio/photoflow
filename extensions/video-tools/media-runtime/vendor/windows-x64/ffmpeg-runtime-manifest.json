  "configureFlags": [
    "--prefix=/c/dev/app1/.cache/media-runtime-build/ffmpeg-lite/prefix",
    "--arch=x86_64",
    "--target-os=mingw32",
    "--enable-gpl",
    "--enable-libx264",
    "--enable-libx265",
    "--enable-libass",
    "--enable-libzimg",
    "--enable-zlib",
    "--enable-mediafoundation",
    "--enable-d3d11va",
    "--enable-ffnvcodec",
    "--enable-nvenc",
    "--enable-static",
    "--disable-shared",
    "--disable-autodetect",
    "--disable-network",
    "--disable-debug",
    "--disable-doc",
    "--disable-ffplay",
    "--disable-ffprobe",
    "--pkg-config=pkg-config",
    "--pkg-config-flags=--static",
    "--extra-cflags=-I/c/dev/app1/.cache/media-runtime-build/ffmpeg-lite/prefix/include",
    "--extra-ldflags=-static",
    "-static-libgcc",
    "-static-libstdc++",
    "-L/c/dev/app1/.cache/media-runtime-build/ffmpeg-lite/prefix/lib"
  ],
