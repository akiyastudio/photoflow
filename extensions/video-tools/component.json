{
  "apiVersion": 1,
  "id": "video-tools",
  "version": "26.8.29.1",
  "displayName": "视频处理",
  "description": "视频转码与无损切割工具",
  "icon": "ui/icon.svg",
  "platforms": ["win32"],
  "architectures": ["x64"],
  "entrypoints": { "win32-x64": "runtime/video-tools-worker.exe" },
  "requiredFiles": ["service.cjs", "runtime/worker.py", "runtime/ffmpeg_transcode.py", "runtime/cut_video.py", "runtime/ffmpeg_utils.py", "runtime/video_preview.py", "ui/transcode.html", "ui/split.html", "ui/app.js", "ui/style.css", "ui/icon.svg", "README.md", "LICENSES/README.md"],
  "componentHost": {
    "contractVersion": 2,
    "legacySettingsAdoptions": [{ "topLevelKey": "videoTools" }],
    "compatibility": { "minHostApiVersion": 7, "maxHostApiVersion": 7 },
    "contributions": [
      { "type": "component.fullPage", "id": "transcode-ui", "title": "视频转码", "entry": "ui/transcode.html" },
      { "type": "component.fullPage", "id": "split-ui", "title": "视频切割", "entry": "ui/split.html" },
      { "type": "component.sidePanel", "id": "transcode", "label": "视频转码", "title": "视频转码", "pageId": "transcode-ui", "placement": "workspace.videoTools", "rpcMethods": ["video-tools.sources.choose.v1", "video-tools.settings.get.v1", "video-tools.settings.update.v1", "video-tools.inspect.v1", "video-tools.transcode.v1", "video-tools.operation.current.v1", "video-tools.operation.control.v1"] },
      { "type": "component.sidePanel", "id": "split", "label": "视频切割", "title": "视频切割", "pageId": "split-ui", "placement": "workspace.videoTools", "rpcMethods": ["video-tools.sources.choose.v1", "video-tools.split.v1", "video-tools.operation.current.v1", "video-tools.operation.control.v1"] }
    ],
    "service": {
      "protocolVersion": 1,
      "runtime": "node",
      "entrypoints": { "default": "service.cjs" },
      "rpcMethods": ["video-tools.sources.choose.v1", "video-tools.settings.get.v1", "video-tools.settings.update.v1", "video-tools.inspect.v1", "video-tools.transcode.v1", "video-tools.split.v1", "video-tools.operation.current.v1", "video-tools.operation.control.v1"],
      "capabilities": ["component.settings.v7", "project.media.process.v7", "dialogs.v7", "component.events.v7"],
      "permissions": ["component.settings", "project.media.process", "dialogs", "events"],
      "events": ["video-tools.operation.progress.v1"],
      "runtimeActions": []
    }
  }
}
