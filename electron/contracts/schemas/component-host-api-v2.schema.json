{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoflow.local/schemas/component-host-api-v2.schema.json",
  "title": "PhotoFlow Host Capability V2 Calls",
  "description": "A method-discriminated request/result pair used for contract validation and SDK generation.",
  "oneOf": [
    { "$ref": "#/$defs/mediaPage" },
    { "$ref": "#/$defs/mediaVariants" },
    { "$ref": "#/$defs/inputTokens" },
    { "$ref": "#/$defs/storage" },
    { "$ref": "#/$defs/settings" },
    { "$ref": "#/$defs/output" },
    { "$ref": "#/$defs/versionCreate" },
    { "$ref": "#/$defs/tasks" },
    { "$ref": "#/$defs/dialogs" },
    { "$ref": "#/$defs/events" },
    { "$ref": "#/$defs/lifecycle" },
    { "$ref": "#/$defs/componentMedia" },
    { "$ref": "#/$defs/projectProgress" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "uuid": { "type": "string", "pattern": "^[A-Fa-f0-9-]{36}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "(^[\\/]|^[A-Za-z]:|(^|[\\/])\\.\\.([\\/]|$))" } },
    "jsonObject": { "type": "object" },
    "versionSourceMetadata": { "type": "object", "additionalProperties": false, "properties": { "category": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "role": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "componentId": { "$ref": "#/$defs/id" }, "parentCapability": { "enum": ["structural", "workflow-input", "none"] } } },
    "apiResult": { "type": "object", "required": ["apiVersion"], "properties": { "apiVersion": { "const": 2 } } },
    "mediaPage": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": {
      "method": { "const": "project.media.page.v2" },
      "payload": { "type": "object", "additionalProperties": false, "properties": { "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 }, "cursor": { "type": ["string", "null"] }, "kinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["image", "raw", "video"] } } } },
      "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["items", "page"], "properties": { "items": { "type": "array" }, "page": { "type": "object" } } }] }
    } },
    "mediaVariants": {
      "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"],
      "properties": { "method": { "const": "project.media.variants.v2" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "photoId": { "type": "string" }, "versionId": { "type": "string" }, "relativePath": { "$ref": "#/$defs/relativePath" }, "variants": { "type": "array", "uniqueItems": true, "items": { "enum": ["thumbnail", "preview", "original"] } } }, "anyOf": [{ "required": ["photoId"] }, { "required": ["relativePath"] }] }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["mediaRef", "metadata", "variants"], "properties": { "mediaRef": { "type": "object" }, "metadata": { "type": "object" }, "variants": { "type": "object", "properties": { "thumbnail": { "$ref": "#/$defs/derivedVariant" }, "preview": { "$ref": "#/$defs/derivedVariant" }, "original": { "$ref": "#/$defs/originalVariant" } } }, "input": { "$ref": "#/$defs/inputGrant" } } }] } }
    },
    "derivedVariant": { "type": "object", "additionalProperties": false, "required": ["url", "maxEdge", "derived"], "properties": { "url": { "type": "string" }, "maxEdge": { "enum": [320, 1600] }, "derived": { "const": true } } },
    "originalVariant": { "type": "object", "additionalProperties": false, "required": ["url", "byteLength", "derived"], "properties": { "url": { "type": "string" }, "byteLength": { "type": "number", "minimum": 0 }, "derived": { "const": false } } },
    "inputGrant": { "type": "object", "additionalProperties": false, "required": ["token", "expiresAt"], "properties": { "token": { "type": "string", "pattern": "^component-input:v2:" }, "expiresAt": { "type": "integer" } } },
    "inputTokens": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "project.input.tokens.v2" }, "payload": { "type": "object", "additionalProperties": false, "required": ["action", "token"], "properties": { "action": { "const": "materialize" }, "token": { "type": "string" } } }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["inputId", "privatePath", "byteLength"], "properties": { "inputId": { "type": "string" }, "privatePath": { "type": "string" }, "byteLength": { "type": "number", "minimum": 0 } } }] } } },
    "storage": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "component.storage.v2" }, "payload": { "type": "object", "maxProperties": 0 }, "result": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["apiVersion", "projectId", "ownership", "adoption"], "properties": { "apiVersion": { "const": 2 }, "projectId": { "type": "string" }, "ownership": { "const": "component-private" }, "adoption": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "state", "componentId", "fromHostApiVersion", "toHostApiVersion", "startedAt"], "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "component-storage-adoption" }, "componentId": { "$ref": "#/$defs/id" }, "fromHostApiVersion": { "const": 1 }, "toHostApiVersion": { "const": 2 }, "state": { "const": "pending" }, "startedAt": { "type": "number", "minimum": 0 } } } } }, { "type": "object", "additionalProperties": false, "required": ["apiVersion", "dataPath", "databasePath", "projectId", "ownership"], "properties": { "apiVersion": { "const": 2 }, "dataPath": { "type": "string" }, "databasePath": { "type": "string" }, "projectId": { "type": "string" }, "ownership": { "const": "component-private" } } }, { "type": "object", "additionalProperties": false, "required": ["apiVersion", "dataPath", "databasePath", "projectId", "ownership", "adoption"], "properties": { "apiVersion": { "const": 2 }, "dataPath": { "type": "string" }, "databasePath": { "type": "string" }, "projectId": { "type": "string" }, "ownership": { "const": "component-private" }, "adoption": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "state", "componentId", "fromHostApiVersion", "toHostApiVersion", "adoptedDataRoot", "adoptedDatabase", "legacyDataRoot", "legacyDatabasePath", "databaseSha256", "copiedFileCount", "copiedByteCount"], "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "component-storage-adoption" }, "componentId": { "$ref": "#/$defs/id" }, "fromHostApiVersion": { "const": 1 }, "toHostApiVersion": { "const": 2 }, "state": { "const": "committed" }, "adoptedDataRoot": { "type": "boolean" }, "adoptedDatabase": { "type": "boolean" }, "legacyDataRoot": { "type": "string" }, "legacyDatabasePath": { "type": "string" }, "databaseSha256": { "type": "string" }, "copiedFileCount": { "type": "integer", "minimum": 0 }, "copiedByteCount": { "type": "number", "minimum": 0 } } } } }] } } },
    "settings": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "component.settings.v2" }, "payload": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "get" } } }, { "type": "object", "additionalProperties": false, "required": ["action", "settings"], "properties": { "action": { "enum": ["replace", "merge"] }, "settings": { "$ref": "#/$defs/jsonObject" } } }] }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["revision", "settings"], "properties": { "revision": { "type": "integer", "minimum": 0 }, "settings": { "$ref": "#/$defs/jsonObject" } } }] } } },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"],
      "properties": {
        "method": { "const": "project.output.v2" },
        "payload": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "stage" } } },
          { "type": "object", "required": ["action", "stageId", "name", "outputRelativePath"], "properties": { "action": { "const": "write" }, "stageId": { "$ref": "#/$defs/uuid" }, "name": { "type": "string" }, "outputRelativePath": { "$ref": "#/$defs/relativePath" }, "sourceName": { "$ref": "#/$defs/relativePath" }, "inputToken": { "type": "string" }, "base64": { "type": "string" }, "replace": { "type": "boolean" }, "previousCommitId": { "$ref": "#/$defs/uuid" }, "previousArtifactId": { "$ref": "#/$defs/uuid" }, "expectedDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
          { "type": "object", "additionalProperties": false, "required": ["action", "stageId"], "properties": { "action": { "enum": ["validate", "rollback"] }, "stageId": { "$ref": "#/$defs/uuid" } } },
          { "type": "object", "additionalProperties": false, "required": ["action", "stageId", "idempotencyKey"], "properties": { "action": { "const": "commit" }, "stageId": { "$ref": "#/$defs/uuid" }, "idempotencyKey": { "$ref": "#/$defs/id" } } },
          { "type": "object", "additionalProperties": false, "required": ["action", "migrationId", "outputs"], "properties": { "action": { "const": "adoptLegacyV1" }, "migrationId": { "$ref": "#/$defs/id" }, "outputs": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "type": "object", "additionalProperties": false, "oneOf": [{ "required": ["relativePath"] }, { "required": ["legacyAbsolutePath"] }], "properties": { "relativePath": { "$ref": "#/$defs/relativePath" }, "legacyAbsolutePath": { "type": "string", "minLength": 1, "maxLength": 4096 }, "artifactId": { "$ref": "#/$defs/uuid" } } } } } },
          { "type": "object", "additionalProperties": false, "required": ["action", "previousCommitId", "previousArtifactId", "expectedDigest", "idempotencyKey"], "properties": { "action": { "const": "delete" }, "previousCommitId": { "$ref": "#/$defs/uuid" }, "previousArtifactId": { "$ref": "#/$defs/uuid" }, "expectedDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "idempotencyKey": { "$ref": "#/$defs/id" } } },
          { "type": "object", "additionalProperties": false, "required": ["action", "commitId", "artifactId"], "properties": { "action": { "const": "materializeOwned" }, "commitId": { "$ref": "#/$defs/uuid" }, "artifactId": { "$ref": "#/$defs/uuid" } } }
        ] },
        "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "anyOf": [
          { "required": ["stageId", "privatePath", "expiresAt"] }, { "required": ["stageId", "artifactId", "byteLength"] },
          { "required": ["stageId", "valid", "fileCount", "totalBytes"] }, { "required": ["stageId", "rolledBack"] },
          { "required": ["commitId", "idempotencyKey", "outputs"] }, { "required": ["deletionId", "deleted", "relativePath"] },
          { "required": ["importId", "privatePath", "byteLength", "sha256", "outputRef"] }
        ] }] }
      }
    },
    "versionCreate": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "version.create.v2" }, "payload": { "type": "object", "additionalProperties": false, "required": ["commitId", "artifactId", "photoId", "parentVersionId", "idempotencyKey"], "properties": { "commitId": { "$ref": "#/$defs/uuid" }, "artifactId": { "$ref": "#/$defs/uuid" }, "photoId": { "type": "string" }, "parentVersionId": { "type": "string" }, "idempotencyKey": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "type": { "type": "string" }, "note": { "type": "string" }, "isFinal": { "type": "boolean" }, "status": { "type": "string" } } }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["versionId", "result"], "properties": { "versionId": { "$ref": "#/$defs/uuid" }, "result": { "$ref": "#/$defs/jsonObject" } } }] } } },
    "tasks": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "tasks.v2" }, "payload": { "type": "object", "required": ["action", "operationId"], "properties": { "action": { "enum": ["start", "report", "status", "cancel", "resume", "complete", "fail"] }, "operationId": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "message": { "type": "string" }, "progress": { "type": "number", "minimum": 0, "maximum": 100 }, "phase": { "type": "string" }, "checkpoint": { "$ref": "#/$defs/jsonObject" }, "error": { "type": "string" } } }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["task", "cancelled"], "properties": { "task": { "type": ["object", "null"] }, "cancelled": { "type": "boolean" }, "checkpoint": { "$ref": "#/$defs/jsonObject" } } }] } } },
    "dialogs": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "dialogs.v2" }, "payload": { "oneOf": [{ "type": "object", "required": ["kind"], "properties": { "kind": { "const": "confirm" }, "title": { "type": "string" }, "message": { "type": "string" } } }, { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "openFiles" }, "title": { "type": "string" }, "extensions": { "type": "array", "maxItems": 64, "items": { "type": "string" } }, "multiple": { "type": "boolean" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "commitId", "artifactId"], "properties": { "kind": { "enum": ["openOutput", "revealOutput"] }, "commitId": { "$ref": "#/$defs/uuid" }, "artifactId": { "$ref": "#/$defs/uuid" } } }] }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "anyOf": [{ "required": ["confirmed"] }, { "required": ["cancelled", "inputs"] }, { "required": ["opened", "outputRef"] }] }] } } },
    "events": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "component.events.v2" }, "payload": { "type": "object", "additionalProperties": false, "required": ["topic", "event"], "properties": { "topic": { "type": "string", "pattern": "\\.v[1-9][0-9]*$" }, "event": { "$ref": "#/$defs/jsonObject" } } }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["emitted"], "properties": { "emitted": { "const": true } } }] } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": { "method": { "const": "component.lifecycle.v2" }, "payload": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "enum": ["describe", "preflight", "install", "repair", "uninstall"] } } }, "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "anyOf": [{ "required": ["componentId", "componentVersion", "negotiatedHostApiVersion", "permissions", "events", "state"] }, { "required": ["success", "action", "taskId", "message"] }] }] } } },
    "componentMedia": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": {
      "method": { "const": "component.media.v2" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["action", "relativePath"], "properties": { "action": { "enum": ["variants", "open", "reveal"] }, "relativePath": { "$ref": "#/$defs/relativePath" }, "variants": { "type": "array", "items": { "enum": ["thumbnail", "preview", "original"] } } } },
      "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object", "required": ["opaqueRef"] }] }
    } },
    "projectProgress": { "type": "object", "additionalProperties": false, "required": ["method", "payload", "result"], "properties": {
      "method": { "const": "project.progress.v2" },
      "payload": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "list" }, "includeMissing": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "relativePath", "mediaKind", "versionKey", "parentProgressId"], "properties": { "action": { "const": "create" }, "relativePath": { "$ref": "#/$defs/relativePath" }, "mediaKind": { "enum": ["image", "video"] }, "versionKey": { "type": "string" }, "parentProgressId": { "type": "string" }, "displayName": { "type": "string" }, "trackingEnabled": { "type": "boolean" }, "sourceMetadata": { "$ref": "#/$defs/versionSourceMetadata" }, "sourceProgressIds": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "childProgressId", "parentProgressId"], "properties": { "action": { "const": "relate" }, "childProgressId": { "type": "string" }, "parentProgressId": { "type": "string" }, "expectedUpdatedAt": { "type": "number" } } }
      ] },
      "result": { "allOf": [{ "$ref": "#/$defs/apiResult" }, { "type": "object" }] }
    } }
  }
}
