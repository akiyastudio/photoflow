{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoflow.local/schemas/media-playback-backend-v1.schema.json",
  "title": "PhotoFlow Media Playback Backend V1 Contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolVersion", "backendId", "transport", "priority", "probe", "features"],
  "properties": {
    "type": { "const": "media.playbackBackend" },
    "protocolVersion": { "const": 1 },
    "backendId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "transport": { "const": "native-process-v1" },
    "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["containers", "codecs", "extensions"],
      "properties": {
        "containers": { "$ref": "#/$defs/tokens" },
        "extensions": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[a-z0-9]{1,12}$" } },
        "codecs": {
          "type": "object", "additionalProperties": false, "required": ["video", "audio"],
          "properties": { "video": { "$ref": "#/$defs/optionalTokens" }, "audio": { "$ref": "#/$defs/optionalTokens" } }
        }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["transforms", "hdr", "statistics", "subtitles", "hardwareDecoding", "capture"],
      "properties": {
        "transforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["source", "contain", "cover", "16:9", "4:3", "1:1", "rotate", "flip-horizontal", "flip-vertical"] } },
        "hdr": { "type": "object", "additionalProperties": false, "required": ["modes", "requiresHdrDisplay"], "properties": { "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["auto", "sdr", "hdr-passthrough", "tone-map"] } }, "requiresHdrDisplay": { "type": "boolean" } } },
        "statistics": { "type": "object", "additionalProperties": false, "required": ["levels", "maxUpdateHz"], "properties": { "levels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["basic", "detailed"] } }, "maxUpdateHz": { "type": "number", "minimum": 0.2, "maximum": 30 } } },
        "subtitles": { "type": "object", "additionalProperties": false, "required": ["formats", "externalFiles"], "properties": { "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["vtt", "srt", "ass", "ssa"] } }, "externalFiles": { "type": "boolean" } } },
        "hardwareDecoding": { "type": "boolean" },
        "capture": { "type": "object", "additionalProperties": false, "required": ["supported", "appliesTransforms"], "properties": { "supported": { "type": "boolean" }, "appliesTransforms": { "type": "boolean" } } }
      }
    }
  },
  "$defs": {
    "tokens": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" } },
    "optionalTokens": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" } }
  }
}
