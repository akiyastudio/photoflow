{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoflow.local/schemas/component-manifest-v2.schema.json",
  "title": "PhotoFlow Component Manifest V2",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "id", "version", "componentHost"],
  "properties": {
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "icon": { "type": "string", "maxLength": 512 },
    "componentHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "compatibility", "contributions", "service"],
      "properties": {
        "contractVersion": { "const": 2 },
        "adoptionGrants": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["component.storage.previous.v1", "project.output.existing.v1"] } },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minHostApiVersion", "maxHostApiVersion"],
          "properties": {
            "minHostApiVersion": { "type": "integer", "minimum": 2 },
            "maxHostApiVersion": { "type": "integer", "minimum": 2 }
          }
        },
        "contributions": {
          "type": "array", "minItems": 2, "maxItems": 32,
          "items": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["type", "id", "label", "pageId"], "properties": { "type": { "const": "workspace.toolbarAction" }, "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "pageId": { "$ref": "#/$defs/id" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "id", "title", "entry"], "properties": { "type": { "const": "component.fullPage" }, "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "entry": { "type": "string", "minLength": 1, "maxLength": 512 } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "id", "label", "entry", "rpcMethods"], "properties": { "type": { "const": "application.settingsPage" }, "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }, "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }, "entry": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }, "rpcMethods": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/versioned" } } } }
            ]
          }
        },
        "service": {
          "type": "object", "additionalProperties": false,
          "required": ["protocolVersion", "runtime", "entrypoints", "rpcMethods", "capabilities", "permissions"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "runtime": { "enum": ["node", "executable"] },
            "entrypoints": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 512 } },
            "rpcMethods": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/versioned" } },
            "capabilities": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["project.media.page.v2", "project.media.variants.v2", "project.input.tokens.v2", "project.output.v2", "version.create.v2", "tasks.v2", "dialogs.v2", "component.storage.v2", "component.settings.v2", "component.events.v2", "component.lifecycle.v2", "component.media.v2", "project.progress.v2", "notifications.v2", "project.files.page.v1", "project.files.search.v1", "project.media.metadata.v1", "project.versions.page.v1", "project.version.graph.v1", "project.media.ratings.v1"] } },
            "permissions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["project.media.read", "project.input.read", "project.output.write", "project.version.create", "component.storage", "component.settings", "tasks", "dialogs", "events", "component.lifecycle.read", "component.lifecycle.manage", "component.media", "project.progress", "notifications", "project.files.read", "project.versions.read", "project.media.ratings.read"] } },
            "events": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/versioned" } },
            "runtimeActions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "lifecycleActions": { "type": "object", "maxProperties": 16 },
            "projectFolders": {
              "type": "array", "maxItems": 32,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:[\\s\\S]*[^.\\s])?$" },
                  "protectFromGenericRename": { "type": "boolean" },
                  "reserveProgressRelocationName": { "type": "boolean" },
                  "legacyAdoptionGrant": { "enum": ["component.storage.previous.v1", "project.output.existing.v1"] }
                },
                "anyOf": [
                  { "required": ["protectFromGenericRename"], "properties": { "protectFromGenericRename": { "const": true } } },
                  { "required": ["reserveProgressRelocationName"], "properties": { "reserveProgressRelocationName": { "const": true } } }
                ]
              }
            }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "contributions": { "contains": { "type": "object", "required": ["type"], "properties": { "type": { "const": "application.settingsPage" } } } } } },
        "then": { "properties": { "compatibility": { "properties": { "minHostApiVersion": { "minimum": 3 }, "maxHostApiVersion": { "minimum": 3 } } } } }
      }, {
        "if": { "properties": { "service": { "properties": { "capabilities": { "contains": { "const": "notifications.v2" } } } } } },
        "then": { "properties": { "compatibility": { "properties": { "minHostApiVersion": { "minimum": 4 } } } } }
      }, {
        "if": { "properties": { "service": { "properties": { "permissions": { "contains": { "const": "notifications" } } } } } },
        "then": { "properties": { "compatibility": { "properties": { "minHostApiVersion": { "minimum": 4 } } } } }
      }, {
        "if": { "properties": { "service": { "properties": { "capabilities": { "contains": { "enum": ["project.files.page.v1", "project.files.search.v1", "project.media.metadata.v1", "project.versions.page.v1", "project.version.graph.v1", "project.media.ratings.v1"] } } } } } },
        "then": { "properties": { "compatibility": { "properties": { "minHostApiVersion": { "minimum": 5 } } } } }
      }, {
        "if": { "properties": { "service": { "properties": { "permissions": { "contains": { "enum": ["project.files.read", "project.versions.read", "project.media.ratings.read"] } } } } } },
        "then": { "properties": { "compatibility": { "properties": { "minHostApiVersion": { "minimum": 5 } } } } }
      }]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "versioned": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,119}\\.v[1-9][0-9]*$" }
  }
}
