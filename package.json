    "test:video-trim": "node scripts/test-video-trim-commit.cjs",
    "test:video-trim-real": ".venv\\Scripts\\python.exe scripts\\test-video-trim-real.py",
    "test:screenshot-main-image": ".venv\\Scripts\\python.exe scripts\\test-screenshot-main-image.py",
    "test:inspiration-gather": "node scripts/test-inspiration-gather.cjs",
    "test:team-retouch": ".venv\\Scripts\\python.exe scripts\\test-team-retouch.py",
    "test:team-workflow": "node scripts/test-team-workflow.mjs && node scripts/test-team-workflow-artifact-service.cjs",
    "test:team-workflow-version-graph": "node scripts/test-team-workflow-version-graph.cjs",
    "preview": "vite preview",
    "electron": "npm run prepare:component-dev && npm run build:shell-thumbnail && npm run build:recycle-bin-service && npm run build:file-clipboard-service && wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"npm run electron\"",
    "cleanup:electron-artifacts": "node scripts/cleanup-electron-artifacts.cjs",
    "electron:build": "npm run generate:icon && npm run generate:installer-terms && npm run build && npm run build:python && npm run build:shell-thumbnail && npm run build:recycle-bin-service && npm run build:file-clipboard-service && electron-builder && npm run cleanup:electron-artifacts"
  },
  "build": {
    "appId": "com.photoflow.toolkit",
    "icon": "packaging/icon.ico",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "artifacts/installers",
      "buildResources": "packaging"
    },
    "files": [
      "artifacts/web/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/exiftool-vendored.pl/**/*"
    ],
    "win": {
      "executableName": "Photoflow",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "artifacts/python/PhotoFlowImportWorker",
          "to": "python/PhotoFlowImportWorker"
        },
        {
          "from": "artifacts/python/inspiration-tools",
          "to": "python/inspiration-tools"
        },
        {
          "from": "artifacts/python/ffmpeg.zip",
          "to": "python/ffmpeg.zip"
        },
        {
          "from": "artifacts/python/ffmpeg-runtime-manifest.json",
          "to": "python/ffmpeg-runtime-manifest.json"
        },
        {
          "from": "electron/bin/shell-thumbnail.exe",
          "to": "shell-thumbnail.exe"
        },
        {
          "from": "electron/bin/recycle-bin-service.exe",
          "to": "recycle-bin-service.exe"
        },
        {
          "from": "electron/bin/file-clipboard-service.exe",
          "to": "file-clipboard-service.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "docs/legal/INSTALLER_TERMS.txt",
      "createDesktopShortcut": false,
      "include": "packaging/installer.nsh",
      "shortcutName": "照片流",
      "uninstallDisplayName": "照片流"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please allow access",
        "NSPhotoLibraryUsageDescription": "需要访问照片以进行整理"
      },
      "extraResources": [
        {
          "from": "artifacts/python/PhotoFlowImportWorker",
          "to": "python/PhotoFlowImportWorker"
        },
        {
          "from": "artifacts/python/inspiration-tools",
          "to": "python/inspiration-tools"
        },
        {
          "from": "artifacts/python/ffmpeg.zip",
          "to": "python/ffmpeg.zip"
        }
      ]
    },
    "extraResources": [
      {
        "from": "python/birthdays.json",
        "to": "python/birthdays.json"
      },
      {
        "from": "docs/legal",
        "to": "legal",
        "filter": [
          "*.html"
        ]
      }
    ]
  },
  "dependencies": {
    "exiftool-vendored": "^30.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.14.0",
    "lucide-react": "^0.344.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
