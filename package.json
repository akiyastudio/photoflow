    "test:installer-terms": "node scripts/test-installer-terms.cjs",
    "test:installer-directory": "node scripts/test-installer-directory.cjs",
    "test:background-tasks": "node scripts/test-background-task-service.cjs && node scripts/test-background-task-migrations.cjs && node scripts/test-background-task-renderer-model.cjs && node scripts/test-dirty-coalescing-runner.cjs && node scripts/test-watch-change-filter.cjs && node scripts/test-media-cache-cleanup-ipc.cjs && node scripts/test-media-tracking-scan-scheduler.cjs && node scripts/test-version-tracking-background.cjs && node scripts/test-sliced-maintenance-runner.cjs",
    "test:process-supervisor": "node scripts/test-process-supervisor.cjs",
    "test:panel-task-sessions": "node scripts/test-panel-task-sessions.cjs",
