    "test:version-tree-layout": "node scripts/test-version-tree-layout-model.cjs",
    "test:version-tree-dag-layout": "node scripts/test-version-tree-dag-layout.cjs",
    "test:version-relation-ipc": "node scripts/test-version-relation-ipc.cjs",
    "test:media-workflow-import": "node scripts/test-media-workflow-import.cjs",
