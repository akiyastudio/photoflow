    "test:domain-journal": "node scripts/test-domain-command-journal.cjs",
    "test:domain-health": "node scripts/test-domain-health.cjs",
    "test:domain-recovery": ".venv\\Scripts\\python.exe scripts\\test-domain-recovery.py",
