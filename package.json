    "test:versioning-v2-db": ".venv\\Scripts\\python.exe scripts\\test-versioning-v2-db.py",
    "test:version-manager-scope": "node scripts/test-metadata-labels.cjs && node scripts/test-version-manager-scope.cjs",
    "test:classify-import": ".venv\\Scripts\\python.exe scripts\\test-classify-import.py",
    "test:backup": ".venv\\Scripts\\python.exe scripts\\test-backup.py",
    "test:backup-service": "node scripts/test-backup-service.cjs",
    "test:storage-usage": "node scripts/test-storage-usage-service.cjs && node scripts/test-media-cache-multi-process.cjs",
    "test:archive-service": "node scripts/test-archive-service.cjs",
    "test:components": "npm run build:team-retouch-renderer && node scripts/test-component-catalog.cjs && node scripts/test-components.cjs && node scripts/test-component-status-refresh-policy.cjs && node scripts/test-component-host.cjs && node scripts/test-component-service.cjs && node scripts/test-team-retouch-component.cjs && node scripts/test-team-retouch-interaction-model.mjs && node scripts/test-team-retouch-advanced-status.mjs",
